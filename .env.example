# ===== IG Insight Lab 環境変数 =====
# このファイルを .env.local にコピーして使います。すべて任意です（空でもデモ・手入力・CSVは動きます）。
# .env.local は Git に含めないでください。

# --- データベース ---
# 未設定: ./.data/pglite に組み込みPostgreSQL（PGlite）で保存（ローカル利用はこれで十分）
# Supabase / PostgreSQL を使う場合は接続文字列を設定（初回起動時に db/schema.sql を自動適用）
DATABASE_URL=
# PGlite の保存先を変える場合
PGLITE_DIR=

# --- アクセス制限（任意） ---
# 設定するとパスコード入力画面が出ます。外部公開する場合は必ず設定してください
APP_PASSCODE=
# セッション署名用（未設定なら APP_PASSCODE を使用）。openssl rand -hex 32 で作成
SESSION_SECRET=

# --- Instagram 公式API（Instagram API with Instagram Login）---
# Meta for Developers のアプリ設定 > Instagram > API setup with Instagram login から取得
META_APP_ID=
META_APP_SECRET=
# アプリに登録したリダイレクトURIと完全一致させる（本番はhttps）
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
# 既定は v25.0（2026-10-11 確認）
META_GRAPH_VERSION=v25.0
# アクセストークン暗号化キー（32バイトをbase64）。openssl rand -base64 32 で作成
TOKEN_ENCRYPTION_KEY=

# --- AI（任意）---
# 未設定のときは「AI未接続」と表示し、ルールベースの施策案を使います
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
